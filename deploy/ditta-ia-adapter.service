[Unit]
Description=DITTA indexer for the Internet Archive (unofficial)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ditta
Group=ditta
WorkingDirectory=/opt/ditta-ia-adapter
# Internet Archive keys, if any: IA_ACCESS_KEY=... and IA_SECRET_KEY=...
EnvironmentFile=-/etc/ditta-ia-adapter.env
# Pick up any new commit on every start. "-": start anyway if offline.
ExecStartPre=-/opt/ditta-ia-adapter/deploy/update.sh --no-restart
ExecStart=/opt/ditta-ia-adapter/.venv/bin/ditta-ia-adapter serve --config /opt/ditta-ia-adapter/config.toml
Restart=on-failure
RestartSec=10
# The home directory is hidden below, so pip gets no cache.
Environment=PIP_NO_CACHE_DIR=1
# The service needs to write only its checkout (state databases, venv).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/ditta-ia-adapter

[Install]
WantedBy=multi-user.target
